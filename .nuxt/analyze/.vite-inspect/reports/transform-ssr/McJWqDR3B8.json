      "name": "vite:vue",
      "result": "\n.article-manager {\n  width: 100%;\n}\n\n.toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1.5rem;\n  gap: 1rem;\n}\n\n.toolbar-left {\n  display: flex;\n  gap: 1rem;\n  flex: 1;\n}\n\n.search-field {\n  max-width: 300px;\n}\n\n.category-filter {\n  max-width: 200px;\n}\n\n.article-table {\n  background: white;\n}\n\n.article-title {\n  max-width: 400px;\n}\n\n.title-text {\n  font-weight: 500;\n  color: #1A1A1A;\n  margin-bottom: 0.25rem;\n}\n\n.excerpt {\n  font-size: 0.875rem;\n  color: #666666;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 0.25rem;\n}\n\n.article-meta {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-bottom: 1rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid #E0E0E0;\n}\n\n.article-excerpt {\n  font-size: 1.1rem;\n  color: #666666;\n  line-height: 1.6;\n  margin-bottom: 1.5rem;\n}\n\n.article-content {\n  line-height: 1.8;\n}\n\n.article-content h3 {\n  color: #1A1A1A;\n  margin: 1.5rem 0 1rem;\n}\n\n.article-content p {\n  margin-bottom: 1rem;\n}\n\n.article-content ul, .article-content ol {\n  margin-bottom: 1rem;\n  padding-left: 1.5rem;\n}\n\n.article-content li {\n  margin-bottom: 0.5rem;\n}\n\n/* 响应式设计 */\n@media (max-width: 768px) {\n  .toolbar {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .toolbar-left {\n    flex-direction: column;\n  }\n  \n  .search-field,\n  .category-filter {\n    max-width: none;\n  }\n  \n  .article-title {\n    max-width: 250px;\n  }\n}\n",
