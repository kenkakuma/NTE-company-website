th:100%}.result-info[data-v-2a917647]{flex:1}.result-name[data-v-2a917647]{color:#1a1a1a;font-weight:500;margin-bottom:.25rem}.result-size[data-v-2a917647]{color:#666;font-size:.875rem;margin:0}.results-actions[data-v-2a917647]{text-align:right}@media (max-width:768px){.upload-area[data-v-2a917647]{padding:2rem 1rem}.upload-title[data-v-2a917647]{font-size:1.25rem}.upload-options[data-v-2a917647],.upload-results[data-v-2a917647]{padding:1rem}}",
